{
  "name": "midnight-otc-protocol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "compact": "compact compile contracts/src/OTCProtocol.compact contracts/managed/otc-protocol",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "generate-seed": "tsx scripts/generate-seed.ts",
    "print-address": "tsx --env-file=.env scripts/print-address.ts",
    "fund": "tsx --env-file=.env scripts/fund.ts",
    "deploy": "tsx --env-file=.env scripts/deploy.ts",
    "init": "tsx --env-file=.env scripts/init.ts",
    "e2e-fraud": "tsx --env-file=.env scripts/e2e-fraud.ts",
    "status": "tsx --env-file=.env scripts/status.ts",
    "probe-swap": "tsx --env-file=.env scripts/probe-swap-semantics.ts",
    "e2e-settle": "tsx --env-file=.env scripts/e2e-settle.ts",
    "compact:testtoken": "compact compile contracts/src/TestToken.compact contracts/managed/test-token",
    "deploy-test-token": "tsx --env-file=.env scripts/deploy-test-token.ts",
    "probe-testusd": "tsx --env-file=.env scripts/probe-testusd-spend.ts",
    "probe-merge-sigs": "tsx --env-file=.env scripts/probe-merge-signatures.ts",
    "probe-fee-calc": "tsx --env-file=.env scripts/probe-fee-calculation.ts",
    "compact:testshieldedtoken": "compact compile contracts/src/TestShieldedToken.compact contracts/managed/test-shielded-token",
    "probe-shielded-latency": "tsx --env-file=.env scripts/probe-shielded-latency.ts",
    "probe-shielded-settle": "tsx --env-file=.env scripts/probe-shielded-settle.ts",
    "e2e-lifecycle": "tsx --env-file=.env scripts/e2e-lifecycle.ts",
    "e2e-settle-2wallet": "tsx --env-file=.env scripts/e2e-settle-2wallet.ts",
    "e2e-rfq-2dealers": "tsx --env-file=.env scripts/e2e-rfq-2dealers.ts",
    "consolidate": "tsx --env-file=.env scripts/consolidate.ts",
    "taker-pinger": "tsx --env-file=.env scripts/taker-pinger.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "turbo": "^2.10.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
