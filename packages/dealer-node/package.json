{
  "name": "@otc/dealer-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "otc-dealer-node": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen-key": "tsx src/bin.ts gen-key",
    "bond": "tsx --env-file-if-exists=../../.env src/bin.ts bond",
    "start": "tsx --env-file-if-exists=../../.env src/bin.ts start",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "8.1.2",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.2",
    "rxjs": "^7.8.1",
    "smol-toml": "^1.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
