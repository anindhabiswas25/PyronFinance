# Copy to .env (git-ignored) and fill in. Never commit this file with real values.

# Copy from .env.preprod, or override for a different network:
MN_NETWORK=preprod
MN_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql
MN_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
MN_RPC=https://rpc.preprod.midnight.network
MN_PROOF_SERVER=http://localhost:6300

# Written automatically by scripts/deploy.ts — leave blank until you've deployed:
MN_CONTRACT_ADDRESS=

# SECRET — never commit. A 64-char hex seed (32 bytes). Generate one with:
#   pnpm generate-seed
MN_WALLET_SEED=

# SECRET — never commit. Encrypts the local private-state cache at rest (not the wallet seed,
# not funds). >= 16 chars. Generate one with: openssl rand -base64 24
MN_PRIVATE_STATE_PASSWORD=
