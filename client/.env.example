# Copy to client/.env.local (git-ignored). Every value is optional.

# preprod | preview. Mainnet is not selectable until the contract is deployed there.
VITE_NETWORK=preprod

# Relays the client connects to (at least two). No public relays exist yet; these are
# the local dev relays from packages/dealer-node/dealer.example.toml.
VITE_RELAYS=ws://127.0.0.1:18787/gossip,ws://127.0.0.1:18788/gossip

# Overrides for the network's contract and indexer (normally taken from networks.ts, or
# from the connected wallet's getConfiguration()).
# VITE_CONTRACT_ADDRESS=
# VITE_INDEXER_HTTP=
# VITE_INDEXER_WS=

